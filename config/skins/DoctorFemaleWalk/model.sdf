<?xml version="1.0" ?>
<sdf version="1.8">
  <actor name="DoctorFemaleWalk">
    <skin>
      <filename>model://config/skins/DoctorFemaleWalk/meshes/DoctorFemaleWalk.dae</filename>
      <scale>1.0</scale>
    </skin>
    <animation name="walk">
      <filename>model://config/skins/DoctorFemaleWalk/meshes/DoctorFemaleWalk.dae</filename>
      <scale>1.0</scale>
      <interpolate_x>true</interpolate_x>
    </animation>
    <plugin filename="libgazebo_ros_actor_plugin.so" 
      name="gazebo_ros_actor_plugin::GazeboRosActorCommand">
      <follow_mode>velocity</follow_mode>
      <vel_topic>/cmd_vel</vel_topic>
      <path_topic>/cmd_path</path_topic>
      <animation_factor>1.0</animation_factor>
      <linear_tolerance>0.1</linear_tolerance>
      <linear_velocity>1</linear_velocity>
      <angular_tolerance>0.0872</angular_tolerance>
      <angular_velocity>2.5</angular_velocity>
      <default_rotation>1.57</default_rotation>
    </plugin>
  </actor>
</sdf>
